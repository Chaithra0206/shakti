<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sos_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚨 SHAKTI SOS BRIDGE"
            android:textColor="#FF5555"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100% OFFLINE"
            android:textColor="#AAAAAA"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="#33FFFFFF" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 1-Tap SOS Button -->
        <LinearLayout
            android:id="@+id/btn_sos_widget"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="2"
            android:background="@drawable/sos_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 SEND SOS"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instant Mesh + SMS"
                android:textColor="#FFEEED"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Siren Button -->
        <LinearLayout
            android:id="@+id/btn_siren_widget"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/siren_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 SIREN"
                android:textColor="#FFB340"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sound Alarm"
                android:textColor="#888888"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
